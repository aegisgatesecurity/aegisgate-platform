{
  "title": "AegisGate Shadow Mode FPR Validation",
  "uid": "aegisgate-shadow-fpr",
  "schemaVersion": 38,
  "version": 1,
  "tags": ["aegisgate", "shadow", "fpr", "validation"],
  "timezone": "browser",
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Shadow Alerts by Detector (Total)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green"},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 10}
            ]
          }
        }
      },
      "targets": [
        {"expr": "sum(aegisgate_shadow_alerts_total)", "legendFormat": "Total Alerts"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 2,
      "title": "Shadow Predictions by Detector (Total)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"steps": [{"color": "blue"}, {"color": "green", "value": 100}]}
        }
      },
      "targets": [
        {"expr": "sum(aegisgate_shadow_predictions_total)", "legendFormat": "Total Predictions"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 3,
      "title": "Alert Rate (%)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green"},
              {"color": "yellow", "value": 1},
              {"color": "red", "value": 5}
            ]
          },
          "unit": "percent"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(aegisgate_shadow_alerts_total[5m])) / sum(rate(aegisgate_shadow_predictions_total[5m])) * 100",
          "legendFormat": "Alert Rate"
        }
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 4,
      "title": "Active VUs (k6)",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {
        "defaults": {"color": {"mode": "thresholds"}, "thresholds": {"steps": [{"color": "blue"}]}}
      },
      "targets": [
        {"expr": "max(shadow_active_vus)", "legendFormat": "VUs"}
      ],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "id": 10,
      "title": "Shadow Alerts by Detector Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "stacking": {"mode": "normal"}
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (detector) (rate(aegisgate_shadow_alerts_total[5m]))",
          "legendFormat": "{{detector}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showValues": false, "calcs": ["sum", "lastNotNull"]}
      }
    },
    {
      "id": 11,
      "title": "Shadow Predictions by Detector Over Time",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10,
            "stacking": {"mode": "normal"}
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (detector) (rate(aegisgate_shadow_predictions_total[5m]))",
          "legendFormat": "{{detector}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showValues": false, "calcs": ["sum", "lastNotNull"]}
      }
    },
    {
      "id": 20,
      "title": "Per-Detector Alert Rate (5m)",
      "type": "barchart",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green"},
              {"color": "yellow", "value": 0.01},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (detector) (rate(aegisgate_shadow_alerts_total[5m]))",
          "legendFormat": "{{detector}}"
        }
      ],
      "options": {"orientation": "horizontal"}
    },
    {
      "id": 21,
      "title": "Per-Detector Alert Count",
      "type": "piechart",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "fieldConfig": {
        "defaults": {"color": {"mode": "palette-classic"}}
      },
      "targets": [
        {
          "expr": "sum by (detector) (aegisgate_shadow_alerts_total)",
          "legendFormat": "{{detector}}"
        }
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "right", "showValues": true, "values": ["value", "percent"]},
        "pieType": "donut"
      }
    },
    {
      "id": 30,
      "title": "Request Traffic (k6)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {"expr": "rate(shadow_requests_total[1m])", "legendFormat": "Total RPS"},
        {"expr": "rate(shadow_benign_total[1m])", "legendFormat": "Benign RPS"},
        {"expr": "rate(shadow_adversarial_total[1m])", "legendFormat": "Adversarial RPS"},
        {"expr": "rate(shadow_blocked_total[1m])", "legendFormat": "Blocked RPS"},
        {"expr": "max(shadow_active_vus)", "legendFormat": "Active VUs"}
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showValues": false, "calcs": ["lastNotNull"]}
      }
    },
    {
      "id": 40,
      "title": "Proxy Latency (p50/p95/p99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "unit": "ms",
          "custom": {"drawStyle": "line", "lineInterpolation": "linear", "fillOpacity": 10}
        }
      },
      "targets": [
        {"expr": "histogram_quantile(0.50, rate(shadow_proxy_latency_ms_bucket[5m]))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, rate(shadow_proxy_latency_ms_bucket[5m]))", "legendFormat": "p95"},
        {"expr": "histogram_quantile(0.99, rate(shadow_proxy_latency_ms_bucket[5m]))", "legendFormat": "p99"}
      ],
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "showValues": false, "calcs": ["lastNotNull"]}
      }
    },
    {
      "id": 41,
      "title": "FPR Validation Status",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "steps": [
              {"color": "green", "text": "PASS"},
              {"color": "red", "value": 1, "text": "FAIL"}
            ]
          },
          "mappings": [
            {"type": "value", "options": {"0": {"text": "PASS — 0% FPR", "color": "green"}}},
            {"type": "range", "options": {"from": 1, "to": 100000, "result": {"text": "FAIL — FP Detected", "color": "red"}}}
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(aegisgate_shadow_alerts_total{detector!=\"l3_neural\"})",
          "legendFormat": "Non-L3 Alerts (should be 0 on benign)"
        }
      ],
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"]},
        "textMode": "auto"
      }
    }
  ],
  "time": {"from": "now-2h", "to": "now"},
  "timepicker": {}
}