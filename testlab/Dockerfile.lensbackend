# =========================================================================
# AegisGate Lens Backend - Testlab Docker Image
# =========================================================================
# Build:  docker build -f testlab/Dockerfile.lensbackend \
#           -t aegisgate-lensbackend:test ../  (run from testlab/)
#         OR
#         docker build -f testlab/Dockerfile.lensbackend \
#           -t aegisgate-lensbackend:test .    (run from platform repo root)
# Run:    docker run --rm -p 9090:9090 \
#           -e LENS_BEARER_TOKEN=test-token \
#           -e LENS_TLS_CERT=/certs/lens.crt \
#           -e LENS_TLS_KEY=/certs/lens.key \
#           -v /tmp/lens-data:/data \
#           aegisgate-lensbackend:test
#
# Self-contained: built from the Platform monorepo, no external
# modules required at build time other than the Go toolchain
# and the stdlib (third-party deps are in the Platform's go.mod
# and resolved at build time from the Go module proxy).
#
# Hardening:
#   - golang:1.26.5-alpine pinned by SHA256 digest
#   - Production stage is debian:stable-slim (we don't have an
#     Alpine lensbackend binary pre-built, so we build it here;
#     once we have a CI step that produces a static lensbackend
#     binary, switch to a multi-stage build with debian:stable-slim
#     as the runtime image to match Dockerfile.fixed4).
#   - Runs as non-root appuser.
#   - HEALTHCHECK hits /api/v1/lens/healthz.
# =========================================================================

# Build context note: this Dockerfile expects to be built with the
# Platform monorepo as the build context. The recommended way is
#
#   cd consolidated/aegisgate-platform/testlab
#   docker build -f Dockerfile.lensbackend -t aegisgate-lensbackend:test ../../
#
# so that COPY ../../go.mod, COPY ../../pkg, etc., find the
# monorepo at the expected paths. We use a build-time ARG to
# allow the platform root to be specified explicitly:
#
#   docker build -f Dockerfile.lensbackend \
#     --build-arg PLATFORM_ROOT=. \
#     -t aegisgate-lensbackend:test ..
#
# Default PLATFORM_ROOT is "..", i.e., the testlab's parent
# directory. This keeps the standard `docker build -f ... ..`
# invocation working.

ARG PLATFORM_ROOT=..

# =========================================================================
# Stage 1: Build the lensbackend binary
# =========================================================================
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder
RUN apk add --no-cache git ca-certificates
WORKDIR /build

ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

# Copy the Platform monorepo source.
COPY ${PLATFORM_ROOT}/go.mod ./
COPY ${PLATFORM_ROOT}/go.sum ./
COPY ${PLATFORM_ROOT}/pkg ./pkg
COPY ${PLATFORM_ROOT}/upstream ./upstream

# Build a separate lensbackend binary at cmd/lensbackend/main.go.
# For now, we use a temporary entry point; once cmd/lensbackend/
# is added in a follow-up step, this will change to:
#
#   RUN CGO_ENABLED=0 GOOS=linux go build \
#     -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT:0:8} -X main.buildDate=${BUILD_DATE}" \
#     -o /lensbackend ./cmd/lensbackend/
#
# For the testlab image, we build a tiny test-main.go that wraps
# the lensbackend.Server. This is intentional: the testlab is for
# integration testing, not production deployment. The production
# binary is the existing aegisgate-platform binary with the
# lensbackend sub-command.
RUN mkdir -p /build/cmd/lensbackend
COPY <<'EOF' /build/cmd/lensbackend/main.go
// SPDX-License-Identifier: Apache-2.0
// Testlab entry point for the lensbackend package.
package main

import (
	"context"
	"log"
	"os"
	"os/signal"
	"syscall"

	"github.com/aegisgatesecurity/aegisgate-platform/pkg/lensbackend"
)

func main() {
	cfg, err := lensbackend.LoadConfig()
	if err != nil {
		log.Fatalf("load config: %v", err)
	}
	srv, err := lensbackend.NewServer(cfg, "testlab-0.1.0")
	if err != nil {
		log.Fatalf("new server: %v", err)
	}

	// Start the retention loop in a goroutine.
	ctx, cancel := context.WithCancel(context.Background())
	defer cancel()
	go srv.RunRetention(ctx)

	// Start the HTTP server (blocking).
	go func() {
		if err := srv.ListenAndServe(); err != nil {
			log.Fatalf("listen: %v", err)
		}
	}()

	// Wait for SIGINT/SIGTERM.
	sig := make(chan os.Signal, 1)
	signal.Notify(sig, syscall.SIGINT, syscall.SIGTERM)
	<-sig
	log.Println("shutting down")
	cancel()
	shutdownCtx, cancelShutdown := context.WithTimeout(context.Background(), 10*1e9)
	defer cancelShutdown()
	_ = srv.Shutdown(shutdownCtx)
}
EOF
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X main.version=${VERSION} -X main.commit=${COMMIT:0:8} -X main.buildDate=${BUILD_DATE}" \
    -o /lensbackend ./cmd/lensbackend/

# =========================================================================
# Stage 2: Minimal runtime
# =========================================================================
FROM debian:stable-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates wget adduser && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    adduser --disabled-password --gecos '' appuser

COPY --from=builder /lensbackend /usr/local/bin/lensbackend

# Create writable data directory.
RUN mkdir -p /data && chown -R appuser:appuser /data

USER appuser

EXPOSE 9090

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget -qO- http://localhost:9090/api/v1/lens/healthz || exit 1

ENTRYPOINT ["lensbackend"]
CMD []
