#!/usr/bin/env bash
# =============================================================================
# AegisGate Security — pre-commit guard rail
# =============================================================================
# Purpose: Enforce the .gitignore policy by BLOCKING commits that stage:
#   1. Files in plans/ or legal-docs/ (internal business strategy)
#   2. Files containing live Stripe keys or webhook secrets
#   3. Billing config with real product/price IDs
#   4. Private key files (.key, .pem, .p12, .keystore)
#   5. .env files with real credentials
#   6. Red team/adversarial testing documents (internal security)
#   7. Install scripts, testlab configs, audit labs (internal infra)
#   8. .env.example with real Stripe price IDs
#
# This hook is committed to the repo and activated via:
#   git config core.hooksPath .githooks
# That way it travels with the repo and is enforced for every clone.
#
# If a doc needs to be published:
#   1. Move it OUT of plans/ or legal-docs/ (e.g., into docs/).
#   2. Strip business-sensitive content (ICP, vendor pricing, counsel work).
#   3. Commit it under its new path. Do NOT force-add from the ignored dir.
# =============================================================================

set -euo pipefail

# Get list of staged files (added, copied, modified, renamed).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR || true)

if [ -z "$STAGED" ]; then
  exit 0  # nothing staged
fi

BLOCKED=0
BLOCKED_LIST=""

# ---------------------------------------------------------------------------
# Check 1: Blocked directories and wildcard patterns (from .gitignore)
# ---------------------------------------------------------------------------
for path in $STAGED; do
  case "$path" in
    plans/*|legal-docs/*|plans-*.md|SPRINT*.md|BUSINESS*.md|PLAN*.md|ROADMAP-INTERNAL.md|CI_DEBT.md|\
    content/pricing.md|pkg/billing/billing-config.json|\
    docs/lens-to-platform-upsell.md|docs/a2a-implementation-roadmap.md|\
    RED-TEAM-*.md|red-team-*.md|install.sh|\
    testlab/*|audit-lab/*|audit-results/*|\
    .env.example|.env.example.*|\
    upstream/aegisgate/pkg/adapters/certs/server.key|\
    upstream/aegisgate/pkg/adapters/custom-certs/server.key|\
    upstream/aegisgate/pkg/proxy/certs/ca/ca.key|\
    D2*-*.md|Sprint-*.md|SPRINT-*-*.md)
      BLOCKED=1
      BLOCKED_LIST="$BLOCKED_LIST  - $path (gitignored internal)$NL"
      ;;
  esac
done

# ---------------------------------------------------------------------------
# Check 2: Secret patterns in staged file content
# ---------------------------------------------------------------------------
NL=$'\n'
for path in $STAGED; do
  # Only scan text files (skip binaries and media)
  case "$path" in
    *.png|*.jpg|*.jpeg|*.gif|*.ico|*.woff|*.woff2|*.ttf|*.eot|*.svg|*.webp|*.mp4|*.mp3)
      continue
      ;;
  esac

  # Read staged content (handles new files and modifications)
  CONTENT=$(git show ":$path" 2>/dev/null || true)
  if [ -z "$CONTENT" ]; then
    continue
  fi

  # Check for live Stripe keys (not test/placeholder patterns)
  if echo "$CONTENT" | grep -qE 'sk_live_[a-zA-Z0-9]{20,}'; then
    BLOCKED=1
    BLOCKED_LIST="$BLOCKED_LIST  - $path (contains live Stripe secret key)$NL"
  fi
  if echo "$CONTENT" | grep -qE 'whsec_[a-zA-Z0-9]{20,}'; then
    BLOCKED=1
    BLOCKED_LIST="$BLOCKED_LIST  - $path (contains Stripe webhook secret)$NL"
  fi

  # Check for private key FILES (not Go code that references private keys).
  # Only flag files that are actual key/cert files, not source code that
  # generates, loads, or validates keys programmatically.
  case "$path" in
    *.key|*.pem|*.p12|*.keystore|*.jks)
      # These file types are already gitignored — if they somehow got staged,
      # block them regardless of content.
      BLOCKED=1
      BLOCKED_LIST="$BLOCKED_LIST  - $path (private key/cert file type)$NL"
      ;;
    *.go|*.ts|*.js|*.py|*.rs|*.java|*.rb|*.mod|*.sum|*.toml|*.yaml|*.yml|*.json|*.md|*.txt|*.gitignore|*.cfg|*.ini|*.conf)
      # Source code and config files frequently reference private keys in
      # comments, string constants, and error messages. Do NOT flag these —
      # the actual .key/.pem files are blocked by path and extension above.
      ;;
    *)
      # For unknown file types, check for actual PEM-encoded private keys
      # (the BEGIN marker + base64 pattern, not just the string "PRIVATE KEY")
      if echo "$CONTENT" | grep -q '\-\-\-\-\-BEGIN.*PRIVATE KEY'; then
        BLOCKED=1
        BLOCKED_LIST="$BLOCKED_LIST  - $path (contains PEM-encoded private key)$NL"
      fi
      ;;
  esac

  # Check for .env with real credentials (not placeholders)
  # Only check actual .env files, not Go source or config files
  case "$path" in
    .env|.env.*|.envrc|*.env)
      if echo "$CONTENT" | grep -qE '(password|secret|token|key)\s*=\s*[a-zA-Z0-9_\-]{16,}'; then
        BLOCKED=1
        BLOCKED_LIST="$BLOCKED_LIST  - $path (may contain hardcoded credentials)$NL"
      fi
      ;;
  esac
done

# ---------------------------------------------------------------------------
# Report and exit
# ---------------------------------------------------------------------------
if [ "$BLOCKED" -eq 1 ]; then
  cat >&2 <<'EOF'

╔══════════════════════════════════════════════════════════════════════════╗
║  PRE-COMMIT BLOCKED: OPSEC violation detected                            ║
╠══════════════════════════════════════════════════════════════════════════╣
║                                                                         ║
║  You tried to stage files that violate AegisGate Security's OPSEC        ║
║  policy. This commit is blocked to prevent leaking internal business     ║
║  strategy, credentials, or private keys to the public repository.       ║
║                                                                         ║
║  Blocked items:                                                         ║
EOF
  printf '%b' "$BLOCKED_LIST" >&2
  cat >&2 <<'EOF'
║                                                                         ║
║  To publish a doc:                                                       ║
║    1. Move it OUT of plans/ or legal-docs/ (e.g., into docs/)           ║
║    2. Strip business-sensitive content                                   ║
║    3. Commit under the new path                                          ║
║                                                                         ║
║  To use billing config:                                                  ║
║    - Copy billing-config.example.json to billing-config.json             ║
║    - billing-config.json is gitignored and loaded at runtime             ║
║                                                                         ║
║  To skip this hook (NOT RECOMMENDED):                                   ║
║    git commit --no-verify                                                ║
║  --no-verify is auditable in the commit's reflog.                       ║
║                                                                         ║
╚══════════════════════════════════════════════════════════════════════════╝

EOF
  exit 1
fi

exit 0